{
  "name": "ebpco-user-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:assets": "node scripts/check-no-third-party-assets.mjs",
    "verify": "npm run check:assets && npm run check:print && npm run check:labels && npm run check:headings && npm run check:vocab && npm run build && npm run check:a11y && npm test -- --watch=false",
    "check:print": "node scripts/check-print-safety.mjs",
    "check:labels": "node scripts/check-form-labels.mjs",
    "check:headings": "node scripts/check-heading-scale.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:vocab": "node scripts/check-permit-vocabulary.mjs"
  },
  "private": true,
  "packageManager": "npm@11.0.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "qrcode-generator": "^1.4.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
